/**
 * 百週年紀念衫意向地圖：Google Apps Script + Google 試算表
 * 由表單擁有者（建議 zalmunna17@gmail.com）在 script.google.com 新建專案。
 * 1. 將本單一 Code.gs 全部貼上到 Apps Script 專案。
 * 2. 手動執行 setupOnce() 授權（資料表已由 ChatGPT 建立）。
 * 3. 部署 -> 新增部署 -> 網頁應用程式 -> 執行身分：我；誰可以存取：所有人。
 * 4. 把部署後 /exec 網址貼入網站的 shirt/config.js。
 * 5. 送出成功即計入統計；僅需在試算表將異常或測試資料改為「排除」。
 * 只在私人試算表保留姓名及尺寸供書房與所屬教會書報組核對，需本人同意，代填者須取得本人同意；公開 API 僅回傳統計，不提供個人資料。
 */
// Non-geolocated registrations count toward the goal without publishing any church/location.
const UNLOCATED_CHURCH_ID_ = 'tjc_0000000000000000';
const UNLOCATED_CHURCH_NAME_ = '未指定地點';
const APP = {
  SPREADSHEET_ID: '1YeD69Wnvbwvf76ouee0qbKuwsMgRM491HlErmONOUXc',
  CATALOG_URL: 'https://www.philemon.com.tw/shirt/churches.json?v=20261112cnprovince1',
  CLOSE_AT: '2026-12-20T23:59:59+08:00',
  TAB: '意向回覆',
  HEADERS: ['建立時間','回覆代碼','教會／客戶ID','姓名','各尺寸明細','總件數','處理狀態','更新時間','備註','名單使用告知','教會／客戶名稱','尺寸件數（易讀）'],
  SIZES: ['110cm','120cm','2XS','XS','S','M','L','XL','2XL','3XL','4XL','5XL']
};
function setupOnce() {
  const s = SpreadsheetApp.openById(APP.SPREADSHEET_ID);
  if (!s.getSheetByName(APP.TAB)) throw new Error('找不到意向回覆分頁');
  Logger.log('試算表已準備完成：' + s.getUrl());
}
function sheet_() {
  const s = SpreadsheetApp.openById(APP.SPREADSHEET_ID);
  const sh = s.getSheetByName(APP.TAB);
  if (!sh) throw new Error('找不到意向回覆分頁');
  return sh;
}
function fullChurchName_(c) {
  const raw=String(c.name||'').trim();
  const taiwan=c.c==='TW'||/^(?:臺灣|台灣|台湾)$/.test(String(c.country||''));
  if (!taiwan || /(?:教會|教会|祈禱所|祈祷所|聚會所|聚会所|禱告所|祷告所|福音中心)$/.test(raw)) return raw;
  return raw+'教會';
}
// 中國大陸只使用省級行政區做意向分類，並無個別教會清單、地址或定位。
function getChurches(){return catalog_().map(c=>({id:c.id,name:fullChurchName_(c),en:c.en,region:c.region,country:c.country,c:c.c,kind:c.kind||'church',aliases:c.aliases||[]}));}
function catalog_(){
  const cache=CacheService.getScriptCache(),data=cache.get('shirt_churches_v3cn');
  if(data) return JSON.parse(data);
  const resp=UrlFetchApp.fetch(APP.CATALOG_URL,{muteHttpExceptions:true});
  if(resp.getResponseCode()!==200)throw new Error('教會清單無法取得，請確認網站已有 /shirt/churches.json');
  const list=JSON.parse(resp.getContentText('UTF-8'));
  if(!Array.isArray(list)||list.length<300)throw new Error('教會清單內容錯誤');
  // CacheService 單筆儲存有長度限制，615 筆完整 JSON 不直接快取；下次由 UrlFetch 重新取得。
  return list;
}
function bridgeHtml_(nonce) {
  const safe=JSON.stringify(String(nonce||''));
  return '<!doctype html><html><head><meta charset="utf-8"></head><body><script>' +
   '(function(){' +
     'const nonce='+safe+';' +
     'const targets=[];' +
     'try{targets.push(window.parent);}catch(e){}' +
     'try{targets.push(window.parent.parent);}catch(e){}' +
     'try{targets.push(window.top);}catch(e){}' +
     'targets.filter(function(w,i){return w&&targets.indexOf(w)===i&&w!==window;}).forEach(function(target){' +
       'const channel=new MessageChannel();' +
       'channel.port1.onmessage=function(e){' +
         'const d=e.data||{};' +
         'if(d.type!=="submit"||typeof d.requestId!=="string"||!d.payload)return;' +
         'google.script.run.withSuccessHandler(function(result){' +
           'channel.port1.postMessage({type:"result",requestId:d.requestId,ok:true,result:result});' +
         '}).withFailureHandler(function(err){' +
           'channel.port1.postMessage({type:"result",requestId:d.requestId,ok:false,error:String(err&&err.message||err)});' +
         '}).submitInterest(d.payload);' +
       '};' +
       'channel.port1.start();' +
       'try{target.postMessage({type:"shirt-bridge-ready",nonce:nonce,protocol:"named-notice-v3"},' +
         '"https://www.philemon.com.tw",[channel.port2]);}catch(e){channel.port1.close();}' +
     '});' +
   '})();' +
   '<\/script></body></html>';
}
function isValidChurchId_(id){
  const cache=CacheService.getScriptCache(),key='shirt_valid_churches_v3cn';
  let json=cache.get(key);
  if(!json){
    const ids=catalog_().map(c=>c.id).filter(x=>/^tjc_[a-f0-9]{16}$/.test(x));
    json=JSON.stringify(ids);
    if(json.length<90000)cache.put(key,json,21600);
  }
  return JSON.parse(json).includes(id);
}
function doGet(e){
  const p=e && e.parameter || {};
  if(p.mode==='bridge'){
    const nonce=String(p.nonce||'');
    if(!/^[a-zA-Z0-9_-]{12,80}$/.test(nonce))return HtmlService.createHtmlOutput('Invalid request');
    return HtmlService.createHtmlOutput(bridgeHtml_(nonce))
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  if(p.mode==='public'){
    const callback=String(p.callback||'');
    if(!/^[A-Za-z_$][A-Za-z0-9_$]{0,48}$/.test(callback))return ContentService.createTextOutput('invalid callback').setMimeType(ContentService.MimeType.TEXT);
    const obj=publicStats_();
    const safe=JSON.stringify(obj).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
    return ContentService.createTextOutput(callback+'('+safe+');').setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return HtmlService.createHtmlOutput(FORM_HTML)
    .setTitle('百週年紀念衫｜意向登記')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
