norm=s=>Array.from(String(s||'').normalize('NFKC').toLowerCase()).map(c=>pairMap.get(c)||c).join('').replace(/[\\s\\-_.·・（）()]/g,'');\nconst data={church:null,list:[],counts:Object.fromEntries(SIZES.map(k=>[k,0])),token:''};\nconst storeKey='shirt_receipt_code_v3';\ntry{data.token=localStorage.getItem(storeKey)||'';}catch(e){}\nconst sum=()=>Object.values(data.counts).reduce((a,b)=>a+b,0);\nfunction paint(){\n  $('total').textContent='共 '+sum()+' 件';\n  document.querySelectorAll('tbody tr').forEach(tr=>{\n    const q=data.counts[tr.dataset.size];tr.querySelector('output').textContent=q;\n    tr.classList.toggle('active',q>0);\n  });\n}\ndocument.querySelectorAll('tbody tr').forEach(tr=>{\n const size=tr.dataset.size;\n tr.querySelector('.less').addEventListener('click',()=>{data.counts[size]=Math.max(0,data.counts[size]-1);paint();});\n tr.querySelector('.more').addEventListener('click',()=>{if(sum()<10){data.counts[size]++;paint();}});\n});\nfunction message(t,kind){\n const el=$('message');el.textContent=t;el.className=kind||'error';el.style.display='block';\n if(kind==='success')setTimeout(()=>{el.style.display='none'},4200);\n}\nconst churchName=c=>{const n=String(c.name||'').trim();return (c.c==='TW'||/^(臺灣|台灣|台湾)$/.test(String(c.country||'')))&&!/(教會|教会|祈禱所|祈祷所|聚會所|聚会所|福音中心|禱告所|祷告所)$/.test(n)?n+'教會':n;};\nfunction choose(c){\n data.church=c;$('church').value=churchName(c);$('church').setAttribute('aria-label','已選擇 '+churchName(c));$('church').classList.add('good');\n $('results').style.display='none';\n try{window.top.postMessage({type:'shirt-church-selected',churchId:c.id},'https://www.philemon.com.tw');}catch(e){}\n}\nfunction search(){\n data.church=null;$('church').classList.remove('good');\n const q=norm($('church').value),res=$('results');\n res.replaceChildren();\n if(!q){res.style.display='none';return;}\n const picks=data.list.filter(c=>[c.name,c.en,c.region,c.country,c.name+'教會',c.name+'教会',...(c.aliases||[])].some(v=>norm(v).includes(q)))\n  .map((c,i)=>{\n    const n=norm(churchName(c)),aliases=(c.aliases||[]).map(norm);\n    const score=n===q?0:n.startsWith(q)?1:aliases.some(a=>a.startsWith(q))?2:n.includes(q)?3:c.kind==='customer'?4:5;\n    return {c,i,score};\n  }).sort((a,b)=>a.score-b.score||a.i-b.i).slice(0,12).map(x=>x.c);\n for(const c of picks){\n   const b=document.createElement('button');b.type='button';b.textContent=churchName(c)+(c.kind==='customer'?' · 客戶':' · '+c.country);\n   b.addEventListener('click',()=>choose(c));res.append(b);\n }\n res.style.display=picks.length?'block':'none';\n}\n$('church').addEventListener('input',search);\n$('church').addEventListener('focus',search);\ndocument.addEventListener('click',ev=>{if(!ev.target.closest('.field'))$('results').style.display='none';});\nif(Date.now()>new Date('2026-12-20T23:59:59+08:00').getTime()){$('send').disabled=true;message('本次意向調查已截止','error');}\nif(!window.google?.script?.run){$('send').disabled=true;message('Google 登記服務尚未就緒','error');}\nelse google.script.run.withSuccessHandler(items=>{data.list=items||[];}).withFailureHandler(err=>message('教會名錄讀取失敗：'+(err.message||String(err)),'error')).getChurches();\n$('interestForm').addEventListener('submit',ev=>{\n ev.preventDefault();\n if(!data.church){message('請從建議名單點選所屬教會','error');return;}\n const fullName=$('fullname').value.trim().normalize('NFKC');\n if(!/^[\\p{L}\\p{M}][\\p{L}\\p{M}.'’\\-\\s]{1,39}$/u.test(fullName)){message('請輸入書報組或中文／英文全名（2～40字）','error');return;}\n if(sum()<1||sum()>10){message('請選擇 1 至 10 件','error');return;}\n let token=data.token;\n if(!/^[0-9a-f-]{36}$/.test(token)){\n   token=window.crypto?.randomUUID?.()||'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{\n     const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);\n   });\n }\n data.token=token;try{localStorage.setItem(storeKey,token);}catch(e){}\n $('send').disabled=true;$('send').textContent='送出中…';\n google.script.run.withSuccessHandler(res=>{\n   data.token='';try{localStorage.removeItem(storeKey);}catch(e){}\n   $('fullname').value='';\n   Object.keys(data.counts).forEach(size=>data.counts[size]=0);paint();\n   $('send').disabled=false;$('send').textContent='送出下一筆 →';\n   message('登記成功！已計入 '+res.total+' 件意向','success');\n   try{window.top.postMessage({type:'shirt-submitted'},'https://www.philemon.com.tw');}catch(e){}\n }).withFailureHandler(err=>{\n   $('send').disabled=false;$('send').textContent='送出意向 →';\n   message('送出失敗：'+(err.message||String(err)),'error');\n }).submitInterest({churchId:data.church.id,name:fullName,sizes:data.counts,honey:$('website').value,token});\n});\n})();\n</script></body></html>";
