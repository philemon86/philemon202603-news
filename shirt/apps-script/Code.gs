idth:30px;height:29px;flex-basis:30px;font-size:19px}\n  .stepper output{font-size:18px}\n  .notes,.notes strong{font-size:12px}\n  #send{font-size:16px;padding:10px 16px}\n}\n@media(max-width:600px){\n  .field label{font-size:15px}\n  .table-title strong{font-size:19px}\n  thead th{font-size:14px}\n  tbody th,tbody td{font-size:16px}\n  .stepper output{font-size:16px}\n  #send{font-size:17px}\n}\n\n</style></head><body>\n<form id=\"interestForm\">\n<div class=\"fields\">\n  <div class=\"field\"><label for=\"church\">01　所屬教會</label><input id=\"church\" type=\"search\" placeholder=\"搜尋教會、教会或 Church\" autocomplete=\"off\" required><div id=\"results\"></div></div>\n  <div class=\"field\"><label for=\"surname\">02　姓氏</label><input id=\"surname\" type=\"text\" maxlength=\"16\" placeholder=\"黃、Chen、Wong\" autocomplete=\"off\" required></div>\n</div>\n<div class=\"table-title\"><strong>03　尺寸表 <small>平量尺寸 · cm</small></strong><span id=\"total\">共 0 件</span></div>\n<div class=\"table-box\"><table aria-label=\"紀念衫尺寸及件數\">\n  <thead><tr><th>尺寸</th><th>肩寬</th><th>胸寬</th><th>衣長</th><th>件數</th></tr></thead>\n  <tbody><tr data-size=\"110cm\"><th scope=\"row\">110cm</th><td>30.5</td><td>35.5</td><td>43</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"110cm 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"110cm 加一件\">+</button></div></td></tr><tr data-size=\"120cm\"><th scope=\"row\">120cm</th><td>32</td><td>38</td><td>46</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"120cm 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"120cm 加一件\">+</button></div></td></tr><tr data-size=\"2XS\"><th scope=\"row\">2XS</th><td>37.5</td><td>45.5</td><td>54.5</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"2XS 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"2XS 加一件\">+</button></div></td></tr><tr data-size=\"XS\"><th scope=\"row\">XS</th><td>39</td><td>49.5</td><td>57</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"XS 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"XS 加一件\">+</button></div></td></tr><tr data-size=\"S\"><th scope=\"row\">S</th><td>42.5</td><td>52</td><td>61</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"S 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"S 加一件\">+</button></div></td></tr><tr data-size=\"M\"><th scope=\"row\">M</th><td>44.5</td><td>56</td><td>63.5</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"M 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"M 加一件\">+</button></div></td></tr><tr data-size=\"L\"><th scope=\"row\">L</th><td>46.5</td><td>59.5</td><td>66</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"L 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"L 加一件\">+</button></div></td></tr><tr data-size=\"XL\"><th scope=\"row\">XL</th><td>48.5</td><td>63.5</td><td>68.5</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"XL 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"XL 加一件\">+</button></div></td></tr><tr data-size=\"2XL\"><th scope=\"row\">2XL</th><td>50</td><td>67.5</td><td>71.5</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"2XL 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"2XL 加一件\">+</button></div></td></tr><tr data-size=\"3XL\"><th scope=\"row\">3XL</th><td>52</td><td>71</td><td>74</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"3XL 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"3XL 加一件\">+</button></div></td></tr><tr data-size=\"4XL\"><th scope=\"row\">4XL</th><td>54</td><td>75</td><td>76.5</td><td><div class=\"stepper\"><button type=\"button\" class=\"less\" aria-label=\"4XL 減一件\">−</button><output>0</output><button type=\"button\" class=\"more\" aria-label=\"4XL 加一件\">+</button></div></td></tr></tbody>\n</table></div>\n<div class=\"bottom\"><div class=\"notes\"><strong>調查至 2027/12/10 23:59</strong><div>僅調查意向，無須付款。公開顯示教會、姓氏及件數。尺寸容許誤差 ±1–2 cm。</div></div><button id=\"send\" type=\"submit\">送出意向 →</button></div>\n<input id=\"website\" class=\"hidden\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n<div id=\"message\" role=\"status\" aria-live=\"polite\"></div>\n</form>\n<script>\n(()=>{\n'use strict';\nconst SIZES=['110cm','120cm','2XS','XS','S','M','L','XL','2XL','3XL','4XL'];\nconst $=id=>document.getElementById(id);\nconst PAIRS=\"乾干亞亚來来俱具倫伦傘伞傳传僑侨內内務务勝胜勢势區区員员問问啟启國国圍围園园圓圆報报壇坛壢坜壩坝壽寿奧奥學学實实寧宁寶宝專专岡冈島岛峽峡崙仑嶼屿巒峦師师庫库廈厦廣广廬庐強强後后復复愛爱慶庆應应戶户擔担昇升晉晋書书會会東东柵栅棧栈楊杨榮荣樂乐樓楼樹树橋桥橫横權权歷历歸归涼凉溝沟滿满漁渔漢汉漬渍澤泽濱滨灣湾烏乌營营爾尔獅狮現现瑪玛璉琏環环發发磯矶禱祷穌稣篤笃簡简紅红納纳紐纽組组綠绿維维線线縣县繼继羅罗義义聖圣腦脑腳脚臥卧臺台興兴莊庄華华萊莱萬万葉叶蓋盖蓮莲蘆芦蘇苏蘭兰號号裡里見见親亲觀观觸触詩诗豐丰貝贝貞贞財财貢贡貴贵賓宾輝辉轄辖農农連连遊游運运達达遠远邊边鄉乡鄰邻醃腌銅铜鋪铺錦锦鎮镇鐵铁長长門门開开間间閣阁閩闽關关阪坂陽阳際际雙双雲云霧雾靈灵靜静韓韩頂顶順顺領领頭头館馆馬马鬧闹魯鲁鰲鳌鳥鸟鳳凤鴨鸭鶯莺鶴鹤鹽盐麗丽麥麦龍龙龜龟\";\nconst pairMap=new Map(Array.from({length:PAIRS.length/2},(_,i)=>[PAIRS[i*2],PAIRS[i*2+1]]));\nconst norm=s=>Array.from(String(s||'').normalize('NFKC').toLowerCase()).map(c=>pairMap.get(c)||c).join('').replace(/[\\s\\-_.·・（）()]/g,'');\nconst data={church:null,list:[],counts:Object.fromEntries(SIZES.map(k=>[k,0])),token:''};\nconst storeKey='shirt_receipt_code_v2';\ntry{data.token=localStorage.getItem(storeKey)||'';}catch(e){}\nconst sum=()=>Object.values(data.counts).reduce((a,b)=>a+b,0);\nfunction paint(){\n  $('total').textContent='共 '+sum()+' 件';\n  document.querySelectorAll('tbody tr').forEach(tr=>{\n    const q=data.counts[tr.dataset.size];tr.querySelector('output').textContent=q;\n    tr.classList.toggle('active',q>0);\n  });\n}\ndocument.querySelectorAll('tbody tr').forEach(tr=>{\n const size=tr.dataset.size;\n tr.querySelector('.less').addEventListener('click',()=>{data.counts[size]=Math.max(0,data.counts[size]-1);paint();});\n tr.querySelector('.more').addEventListener('click',()=>{if(sum()<10){data.counts[size]++;paint();}});\n});\nfunction message(t,kind){\n const el=$('message');el.textContent=t;el.className=kind||'error';el.style.display='block';\n if(kind==='success')setTimeout(()=>{el.style.display='none'},4200);\n}\nconst churchName=c=>{const n=String(c.name||'').trim();return (c.c==='TW'||/^(臺灣|台灣|台湾)$/.test(String(c.country||'')))&&!/(教會|教会|祈禱所|祈祷所|聚會所|聚会所|福音中心|禱告所|祷告所)$/.test(n)?n+'教會':n;};\nfunction choose(c){\n data.church=c;$('church').value=churchName(c);$('church').setAttribute('aria-label','已選擇 '+churchName(c));$('church').classList.add('good');\n $('results').style.display='none';\n try{window.top.postMessage({type:'shirt-church-selected',churchId:c.id},'https://www.philemon.com.tw');}catch(e){}\n}\nfunction search(){\n data.church=null;$('church').classList.remove('good');\n const q=norm($('church').value),res=$('results');\n res.replaceChildren();\n if(!q){res.style.display='none';return;}\n const picks=data.list.filter(c=>[c.name,c.en,c.region,c.country,c.name+'教會',c.name+'教会'].some(v=>norm(v).includes(q))).slice(0,10);\n for(const c of picks){\n   const b=document.createElement('button');b.type='button';b.textContent=churchName(c)+' · '+c.country;\n   b.addEventListener('click',()=>choose(c));res.append(b);\n }\n res.style.display=picks.length?'block':'none';\n}\n$('church').addEventListener('input',search);\n$('church').addEventListener('focus',search);\ndocument.addEventListener('click',ev=>{if(!ev.target.closest('.field'))$('results').style.display='none';});\nif(Date.now()>new Date('2027-12-10T23:59:59+08:00').getTime()){$('send').disabled=true;message('本次意向調查已截止','error');}\nif(!window.google?.script?.run){$('send').disabled=true;message('Google 登記服務尚未就緒','error');}\nelse google.script.run.withSuccessHandler(items=>{data.list=items||[];}).withFailureHandler(err=>message('教會名錄讀取失敗：'+(err.message||String(err)),'error')).getChurches();\n$('interestForm').addEventListener('submit',ev=>{\n ev.preventDefault();\n if(!data.church){message('請從建議名單點選所屬教會','error');return;}\n const surname=$('surname').value.trim();\n if(!surname){message('請填寫姓氏','error');return;}\n if(sum()<1||sum()>10){message('請選擇 1 至 10 件','error');return;}\n let token=data.token;\n if(!/^[0-9a-f-]{36}$/.test(token)){\n   token=window.crypto?.randomUUID?.()||'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{\n     const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3|8)).toString(16);\n   });\n }\n $('send').disabled=true;$('send').textContent='送出中…';\n google.script.run.withSuccessHandler(res=>{\n   data.token=res.token;try{localStorage.setItem(storeKey,res.token);}catch(e){}\n   $('send').disabled=false;$('send').textContent='更新意向 →';\n   message('登記成功！已計入 '+res.total+' 件意向','success');\n   try{window.top.postMessage({type:'shirt-submitted'},'https://www.philemon.com.tw');}catch(e){}\n }).withFailureHandler(err=>{\n   $('send').disabled=false;$('send').textContent='送出意向 →';\n   message('送出失敗：'+(err.message||String(err)),'error');\n }).submitInterest({churchId:data.church.id,surname,sizes:data.counts,honey:$('website').value,token});\n});\n})();\n</script></body></html>";
