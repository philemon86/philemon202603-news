function churchMetadata_(id){
  // O(1) local lookup removes UrlFetchApp from the registration hot path.
  if(Object.prototype.hasOwnProperty.call(SHIRT_FAST_REGISTRATION_NAMES_,id)){
    return {name:SHIRT_FAST_REGISTRATION_NAMES_[id]};
  }
  const cache=CacheService.getScriptCache(),key='shirt_church_metadata_v3cn';
  let json=cache.get(key);
  if(!json){
    const mapping={};
    for(const c of catalog_()){
      if(/^tjc_[a-f0-9]{16}$/.test(String(c.id||''))){
        mapping[c.id]={name:fullChurchName_(c),country:c.country||'',c:c.c||''};
      }
    }
    json=JSON.stringify(mapping);
    if(json.length<95000)cache.put(key,json,21600);
  }
  const record=JSON.parse(json)[id];
  return record||null;
}
function submitInterest(payload){
  if(Date.now()>new Date(APP.CLOSE_AT).getTime())throw new Error('本次調查已截止');
  if(!payload || payload.honey)throw new Error('無法送出，請重新載入');
  // Blank or unmatched text is intentionally treated as anonymous location data.
  // Never store arbitrary, potentially sensitive unlisted congregation names.
  const rawId=String(payload.churchId||'');
  const cId=rawId||UNLOCATED_CHURCH_ID_;
  if(!/^tjc_[a-f0-9]{16}$/.test(cId))throw new Error('登記地區資料格式不正確');
  const church=cId===UNLOCATED_CHURCH_ID_?{name:UNLOCATED_CHURCH_NAME_}:churchMetadata_(cId);
  if(!church)throw new Error('登記地區尚未啟用，請更新頁面再試');
  const fullName=String(payload.name||'').trim().normalize('NFKC');
  if(!/^[\p{L}\p{M}][\p{L}\p{M}.'’\-\s]{1,39}$/u.test(fullName))throw new Error('請輸入書報組或中文／英文全名（2～40字）');
  const counts={},raw=payload.sizes||{};
  for(const size of APP.SIZES){
    const value=Number(raw[size]||0);
    if(!Number.isInteger(value)||value<0||value>10)throw new Error('每個尺寸請填0到10件');
    counts[size]=value;
  }
  const total=Object.values(counts).reduce((a,b)=>a+b,0);
  if(total<1||total>10)throw new Error('每次登記最多10件、至少1件；大量需求請來信書房');
  let token=String(payload.token||'');
  if(!/^[0-9a-f-]{36}$/.test(token))throw new Error('回覆代碼格式不正確，請重新整理頁面');
  const now=new Date(),lock=LockService.getScriptLock();lock.waitLock(15000);
  try{
    const sh=sheet_(),last=sh.getLastRow();
    let found=-1;
    if(last>1){const tokens=sh.getRange(2,2,last-1,1).getValues();found=tokens.findIndex(x=>String(x[0])===token);}
    const breakdown=APP.SIZES.filter(size=>counts[size]>0).map(size=>size+' × '+counts[size]).join('、');
    const row=[now,token,cId,fullName,JSON.stringify(counts),total,'已登記',now,'','已告知',church.name,breakdown];
    if(found>=0){ const rowNo=found+2;row[0]=sh.getRange(rowNo,1).getValue();sh.getRange(rowNo,1,1,APP.HEADERS.length).setValues([row]); }
    else sh.appendRow(row);
    CacheService.getScriptCache().remove('shirt_public_v3');
    return {ok:true,token:token,total:total,message:'登記成功，已列入再製作意向統計'};
  }finally{lock.releaseLock();}
}
function publicStats_(){
 const cache=CacheService.getScriptCache(),cached=cache.get('shirt_public_v3');
 if(cached)return JSON.parse(cached);
 const sh=sheet_(),last=sh.getLastRow();
 const rows=last>1?sh.getRange(2,1,last-1,8).getValues():[];
 const stats=new Map();let total=0,people=0;
 for(const r of rows){
  const id=String(r[2]||''),qty=Number(r[5])||0,status=String(r[6]||'已登記');
  if(!/^tjc_[a-f0-9]{16}$/.test(id)||!Number.isInteger(qty)||qty<1||qty>10||status==='排除')continue;
  // Always count valid pieces and people; map only verified named locations.
  if(id!==UNLOCATED_CHURCH_ID_){
   if(!stats.has(id))stats.set(id,{id,confirmed:0,pending:0});
   stats.get(id).confirmed+=qty;
  }
  total+=qty;
  people+=1; // One valid response row represents one registrant, regardless of quantity.
 }
 // Public data: one person per valid registration row; never include names or receipt tokens.
 const result={total,people,churches:[...stats.values()],updatedAt:new Date().toISOString()};
 const json=JSON.stringify(result);
 if(json.length<95000)cache.put('shirt_public_v3',json,12);
